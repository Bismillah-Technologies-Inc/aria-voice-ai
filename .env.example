# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Deepgram
DEEPGRAM_API_KEY=dg_xxxxxxxxxxxxxxxxxxxx

# Deepgram Voice Agent LLM (managed provider — no credentials needed)
DEEPGRAM_LLM_PROVIDER=anthropic
DEEPGRAM_LLM_MODEL=claude-sonnet-4-5

# Voice output
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-helena-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_LANGUAGE_CODE=en-US
TTS_FALLBACK_TO_DEEPGRAM=true
INFO_LINK=https://yourdomain.com/aria

# Bedrock — Post-call summary (Claude Sonnet 4.5)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1

# Bedrock — Orchestrator (Amazon Nova Micro — fastest)
BEDROCK_ORCHESTRATOR_MODEL_ID=amazon.nova-micro-v1:0

# Database
DB_HOST=aria-mvp.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=aria
DB_USER=aria_user
DB_PASSWORD=changeme

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=aria@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GOOGLE_CALENDAR_ID=primary

# Reply forwarding
MIRZA_PHONE=+1XXXXXXXXXX

# Telnyx (telephony — replaces Amazon Connect)
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_FROM_NUMBER=+1XXXXXXXXXX
TELNYX_TRANSFER_NUMBER=+1XXXXXXXXXX   # human agent number for transfers
TELNYX_APP_ID=                         # legacy Call Control application id for rollback
TELNYX_SHADOW_NUMBER=+1XXXXXXXXXX      # optional shadow number for assistant validation
TELNYX_ASSISTANT_ID=
TELNYX_ASSISTANT_TEXML_APP_ID=
TELNYX_ASSISTANT_NAME=aria-dev
TELNYX_ASSISTANT_MODEL=anthropic/claude-haiku-4-5
TELNYX_ASSISTANT_VOICE=Telnyx.NaturalHD.astra
TELNYX_ASSISTANT_VOICE_SPEED=0.95
TELNYX_ASSISTANT_TRANSCRIPTION_MODEL=deepgram/nova-3
TELNYX_ASSISTANT_TRANSCRIPTION_LANGUAGE=en-US
TELNYX_ASSISTANT_WEBHOOK_SECRET=replace-me
TELNYX_ASSISTANT_INSIGHT_GROUP_ID=
TELNYX_ASSISTANT_WEBHOOK_BASE_URL=

# EC2 Bridge (set after running setup-ec2.sh)
EC2_WSS_URL=wss://stream.yourdomain.com
POST_CALL_HANDLER_URL=

# Demo config
BOOKING_LINK=https://cal.com/aria-demo
HUMAN_TRANSFER_HOURS_START=9    # 9 AM CT
HUMAN_TRANSFER_HOURS_END=17     # 5 PM CT
HUMAN_TRANSFER_TIMEZONE=America/Chicago
DEMO_BUSINESS_NAME=Apex Home Services
DEMO_AGENT_NAME=Aria

# Dashboard (set after running setup-aws.sh — values come from CloudFormation outputs)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard frontend (Vite — copy to dashboard/.env.local for local dev)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
